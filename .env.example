# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
# Safe in the browser: RLS controls what this key can read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Bypasses RLS, used by ingestion to write chunks. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Google Gemini (aistudio.google.com > Get API key) ---
# Server only.
GEMINI_API_KEY=xxx
# Tried in order. On 429 (out of quota) or 503 (overloaded) the next model is used,
# since each model has its own free-tier daily quota.
GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-2.5-flash
# One model only, no fallback: vectors from different models can't be compared.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(N) column size. Changing it means re-embedding everything.
EMBEDDING_DIMENSIONS=768

# --- App ---
# Used for auth email links (sign-up confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
